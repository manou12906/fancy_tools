#!/bin/bash

SRC_DIR="$HOME/src/fancy_tools"

cd "$SRC_DIR" || exit

# Vérifier branche main
CURRENT_BRANCH=$(git branch --show-current)

if [ "$CURRENT_BRANCH" != "main" ]; then
    echo "Passage sur la branche main..."
    git checkout main
fi

echo "Mise à jour..."
git pull

echo "Copie du script..."
cp bin/updateFancyTools ~/bin/

echo "Mise à jour terminée !"
